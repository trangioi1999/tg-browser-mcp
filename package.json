{
  "name": "tg-browser-mcp",
  "version": "0.1.0",
  "description": "Secure, token-efficient browser automation MCP server and harness for AI agents (Playwright-based)",
  "main": "dist/sdk.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/e2e",
    "fixture": "node tests/fixtures/app/server.mjs",
    "start": "node dist/index.js start",
    "doctor": "node dist/index.js doctor",
    "prepublishOnly": "npm run build",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "bench": "tsx scripts/benchmark-tokens.ts",
    "schema-size": "tsx scripts/schema-size.ts"
  },
  "keywords": [
    "mcp",
    "playwright",
    "browser-automation",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pino": "^10.4.0",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/mcp": "^0.0.86",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "types": "dist/sdk.d.ts",
  "bin": {
    "tg-browser-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tg-browser.config.example.json"
  ],
  "engines": {
    "node": ">=20.10"
  }
}
